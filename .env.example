# ── Copy this file to ".env" and fill in the values you have. ──
# You can run the whole app with NONE of these set (simulator mode).

# Web server port
PORT=3000

# ── CONTROL PANEL SECURITY ──
# Password to open the private control panel (buyer names, totals, buttons).
# The public buyer view (/public) needs no password and shows no sensitive data.
PANEL_PASSWORD=change-this-to-something-strong
# Optional: a long random string to keep logins valid across restarts.
# If left blank, a new one is generated each boot (everyone re-logs in after a restart).
SESSION_SECRET=

# ── DEMO / SIMULATOR ──
# true = generate fake orders so you can see the queue work without TikTok.
SIMULATE=true
# milliseconds between simulated orders (2500 = fast demo; ~60000 = realistic)
SIM_INTERVAL_MS=2500

# ── TIKTOK SHOP (turn on after authorizing your shop to the app) ──
TIKTOK_ENABLED=false
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Filled in automatically after authorizing (also seedable here so the app can
# refresh on boot). ACCESS token is short-lived; REFRESH is the durable seed.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=
# The Partner Center authorization link (used by the panel's "Reconnect" button).
TIKTOK_AUTH_URL=
# How often to poll for new orders while live (ms).
TIKTOK_POLL_MS=10000
# usually leave these defaults:
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_API_VERSION=202309

# ── DISCORD MIRROR (optional) ──
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
